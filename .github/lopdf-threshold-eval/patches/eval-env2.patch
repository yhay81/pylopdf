+/// `LOPDF_MIN_PARALLEL_MEMBERS` the object stream member threshold and
+/// `LOPDF_MIN_PARALLEL_BYTES` the byte threshold, each read once per process.
+#[cfg(feature = "rayon")]
+pub(crate) fn eval_threshold(name: &'static str, default: usize) -> usize {
+    use std::sync::OnceLock;
+    static ENTRIES: OnceLock<Option<usize>> = OnceLock::new();
+    static MEMBERS: OnceLock<Option<usize>> = OnceLock::new();
+    static BYTES: OnceLock<Option<usize>> = OnceLock::new();
+    let cell = match name {
+        "LOPDF_MIN_PARALLEL" => &ENTRIES,
+        "LOPDF_MIN_PARALLEL_MEMBERS" => &MEMBERS,
+        "LOPDF_MIN_PARALLEL_BYTES" => &BYTES,
+        _ => unreachable!("unknown threshold {name}"),
+    };
+    cell.get_or_init(|| std::env::var(name).ok().and_then(|v| v.parse().ok()))
+        .unwrap_or(default)
+}
