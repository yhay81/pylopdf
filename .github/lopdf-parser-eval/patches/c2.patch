+    #[test]
+    fn character_classes_follow_the_standard() {
+        // ISO 32000-2, 7.2.3: the white-space and delimiter characters; every other byte is regular.
+        for c in 0..=u8::MAX {
+            assert_eq!(is_whitespace(c), b" \t\n\r\0\x0C".contains(&c), "{c:#04x}");
+            assert_eq!(is_delimiter(c), b"()<>[]{}/%".contains(&c), "{c:#04x}");
+            assert_eq!(is_regular(c), !b" \t\n\r\0\x0C()<>[]{}/%".contains(&c), "{c:#04x}");
+            assert_eq!(is_direct_literal_string(c), !b"()\\\r\n".contains(&c), "{c:#04x}");
