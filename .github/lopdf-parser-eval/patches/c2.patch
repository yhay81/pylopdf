+/// White space and comments, as many as there are.
+fn space(mut input: ParserInput) -> NomResult<()> {
+    loop {
+        let blanks = input.iter().take_while(|&&c| is_whitespace(c)).count();
+        if blanks > 0 {
+            input = &input[blanks..];
+        } else if input.first() == Some(&b'%')
+            && let Ok((rest, ())) = comment(input)
+        {
+            input = rest;
+        } else {
+            return Ok((input, ()));
+        }
+    }
 }
 
