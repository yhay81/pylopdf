+        assert_eq!(rest(b"% one\n%two\r\n \0% three\r/A"), b"/A");
+        assert_eq!(rest(b"/A"), b"/A");
+        assert_eq!(rest(b""), b"");
+        // A comment ends with an end-of-line marker, without which it is left unread.
